# Supabase (create a project at https://supabase.com, then Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (https://platform.claude.com) - screenshot verification + RAG answers
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Voyage AI embeddings for vector retrieval (https://voyageai.com).
# Leave unset to use Postgres full-text search retrieval instead.
VOYAGE_API_KEY=

# Google Calendar OAuth (optional — .ics upload works without it)
# console.cloud.google.com → enable Google Calendar API → OAuth consent screen
# (External, scope calendar.events.readonly) → Credentials → OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:3000/api/calendar/google/callback
#   https://<your-domain>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
